#include "AMDGPUEarlyRegisterSpilling.h"
#include "AMDGPU.h"
#include "AMDGPUNextUseAnalysis.h"
#include "GCNSubtarget.h"
#include "llvm/ADT/SmallPtrSet.h"
#include "llvm/ADT/Statistic.h"
#include "llvm/CodeGen/MachineFrameInfo.h"
#include "llvm/InitializePasses.h"
#include "llvm/Support/GenericIteratedDominanceFrontier.h"
#include <algorithm>
#include <cmath>

using namespace llvm;

#define DEBUG_TYPE "amdgpu-early-register-spilling"

STATISTIC(NumOfERSSpills, "Number of ERS spills");

static cl::opt<bool> EarlyRegisterSpilling("early-register-spilling",
                                           cl::init(true), cl::Hidden);

static cl::opt<bool> EarlyRegisterSpillingSGPRs("early-register-spilling-sgprs",
                                                cl::init(false), cl::Hidden);

static cl::opt<unsigned>
    VGPRMaxNums("max-vgprs", cl::init(20), cl::Hidden,
                cl::desc("The maximum number of VGPRs per wave."));

static cl::opt<unsigned>
    SGPRMaxNums("max-sgprs", cl::init(0), cl::Hidden,
                cl::desc("The maximum number of SGPRs per wave."));

bool isVCCRegister(Register Reg) {
  return Reg == AMDGPU::VCC || Reg == AMDGPU::VCC_LO || Reg == AMDGPU::VCC_HI;
}

bool isSpillSaveInstr(MachineInstr *MI) {
  if (MI->getOpcode() == AMDGPU::SI_SPILL_S32_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S64_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S96_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S128_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S160_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S192_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S224_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S256_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S288_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S320_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S352_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S384_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S512_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S1024_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V32_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V64_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V96_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V128_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V160_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V192_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V224_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V256_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V288_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V320_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V352_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V384_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V512_SAVE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V1024_SAVE)
    return true;
  return false;
}

bool isSpillRestoreInstr(MachineInstr *MI) {
  if (MI->getOpcode() == AMDGPU::SI_SPILL_S32_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S64_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S96_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S128_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S160_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S192_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S224_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S256_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S288_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S320_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S352_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S384_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S512_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_S1024_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V32_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V64_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V96_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V128_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V160_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V192_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V224_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V256_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V288_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V320_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V352_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V384_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V512_RESTORE ||
      MI->getOpcode() == AMDGPU::SI_SPILL_V1024_RESTORE)
    return true;
  return false;
}

bool isBranchInstr(MachineInstr *MI) {
  if (MI->getOpcode() == AMDGPU::SI_IF || MI->getOpcode() == AMDGPU::SI_ELSE ||
      MI->getOpcode() == AMDGPU::SI_LOOP ||
      MI->getOpcode() == AMDGPU::SI_IF_BREAK ||
      MI->getOpcode() == AMDGPU::SI_WATERFALL_LOOP ||
      MI->getOpcode() == AMDGPU::SI_END_CF ||
      MI->getOpcode() == AMDGPU::SI_BR_UNDEF ||
      MI->getOpcode() == AMDGPU::S_SETPC_B64 ||
      MI->getOpcode() == AMDGPU::SI_KILL_I1_TERMINATOR ||
      MI->getOpcode() == AMDGPU::SI_KILL_F32_COND_IMM_TERMINATOR ||
      MI->getOpcode() == AMDGPU::SI_EARLY_TERMINATE_SCC0 ||
      MI->getOpcode() == AMDGPU::S_BRANCH ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_CDBGSYS ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_CDBGSYS_AND_USER ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_CDBGSYS_OR_USER ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_CDBGUSER ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_SCC0 ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_SCC1 ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_VCCNZ ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_VCCZ ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_EXECNZ ||
      MI->getOpcode() == AMDGPU::S_CBRANCH_EXECZ)
    return true;
  return false;
}

void AMDGPUEarlyRegisterSpilling::updateIndexes(MachineInstr *MI) {
  if (Indexes->hasIndex(*MI))
    Indexes->removeMachineInstrFromMaps(*MI);
  Indexes->insertMachineInstrInMaps(*MI);
}

void AMDGPUEarlyRegisterSpilling::updateLiveness(Register Reg) {
  if (LIS->hasInterval(Reg))
    LIS->removeInterval(Reg);
  LIS->createAndComputeVirtRegInterval(Reg);
}

void AMDGPUEarlyRegisterSpilling::updateLiveness(MachineInstr *MI) {
  for (auto &MO : MI->operands()) {
    if (MO.isReg()) {
      auto Reg = MO.getReg();
      if (Reg.isVirtual()) {
        if (LIS->hasInterval(Reg))
          LIS->removeInterval(Reg);
        LIS->createAndComputeVirtRegInterval(Reg);
      }
    }
  }
}

// We need this because it does not make sense to spill a def which has a use in
// a phi at the beginning of a basic block and it is defined a bit later.
bool AMDGPUEarlyRegisterSpilling::hasPHIUseInSameBB(Register Reg,
                                                    MachineBasicBlock *CurMBB) {
  for (auto &UseMI : MRI->use_nodbg_instructions(Reg))
    if (UseMI.isPHI() && UseMI.getParent() == CurMBB)
      return true;
  return false;
}

MachineInstr *
AMDGPUEarlyRegisterSpilling::emitRestore(Register DefRegToSpill,
                                         MachineInstr *DefRegUseInstr,
                                         MachineBasicBlock *InsertBB, int FI) {
  const TargetRegisterClass *RC = TRI->getRegClassForReg(*MRI, DefRegToSpill);
  Register NewReg = MRI->createVirtualRegister(RC);
  RestoredRegs.insert(NewReg);
  MachineBasicBlock *DefRegUseInstrBB = DefRegUseInstr->getParent();
  MachineInstr *Restore = nullptr;
  if (InsertBB == DefRegUseInstrBB &&
      DefRegUseInstr->getOpcode() != AMDGPU::PHI) {
    // Common case
    TII->loadRegFromStackSlot(*DefRegUseInstrBB, DefRegUseInstr->getIterator(),
                              NewReg, FI, RC, TRI, Register());
    Restore = DefRegUseInstr->getPrevNode();
  } else {
    // Special case for phi nodes: we emit the restore instructions at the
    // bottom of the incoming blocks.
    auto It = InsertBB->getFirstTerminator();
    if (It == InsertBB->end())
      It = InsertBB->instr_end();
    TII->loadRegFromStackSlot(*InsertBB, It, NewReg, FI, RC, TRI, Register());
    Restore = &*(std::prev(It));
  }
  DefRegUseInstr->substituteRegister(DefRegToSpill, NewReg, 0, *TRI);
  LIS->InsertMachineInstrInMaps(*Restore);
  LLVM_DEBUG(dbgs() << "Register to spill = " << printReg(DefRegToSpill, TRI)
                    << " Register to replace spilled register = "
                    << printReg(NewReg, TRI) << "\n");
  return Restore;
}

MachineInstr *
AMDGPUEarlyRegisterSpilling::emitRestore(Register DefRegToSpill,
                                         MachineBasicBlock *InsertBB, int FI) {
  const TargetRegisterClass *RC = TRI->getRegClassForReg(*MRI, DefRegToSpill);
  Register NewReg = MRI->createVirtualRegister(RC);
  RestoredRegs.insert(NewReg);
  auto It = InsertBB->getFirstTerminator();
  if (It == InsertBB->end())
    It = InsertBB->instr_end();
  TII->loadRegFromStackSlot(*InsertBB, It, NewReg, FI, RC, TRI, Register());
  MachineInstr *Restore = &*(std::prev(It));
  LIS->InsertMachineInstrInMaps(*Restore);
  LLVM_DEBUG(dbgs() << "Register to spill = " << printReg(DefRegToSpill, TRI)
                    << " Register to replace spilled register = "
                    << printReg(NewReg, TRI) << "\n");
  return Restore;
}

// TODO: Update these conditions
bool AMDGPUEarlyRegisterSpilling ::isLegalToSpill(Register CandidateReg) {
  MachineInstr *CandidateMI = &*MRI->def_instr_begin(CandidateReg);
  return !hasPHIUseInSameBB(CandidateReg, CandidateMI->getParent()) &&
         !MRI->use_nodbg_empty(CandidateReg) &&
         !isSpillSaveInstr(CandidateMI) && !isSpillRestoreInstr(CandidateMI) &&
         !isSpilledReg(CandidateReg) && !isRestoredReg(CandidateReg) &&
         !CandidateReg.isPhysical() && !TRI->isAGPR(*MRI, CandidateReg) &&
         !isVCCRegister(CandidateReg) && !isBranchInstr(CandidateMI);
}

SmallVector<Register> AMDGPUEarlyRegisterSpilling::getRegistersToSpill(
    MachineInstr *CurMI, GCNDownwardRPTracker &RPTracker, bool IsVGPR) {
  assert(!EarlyRegisterSpillingSGPRs && IsVGPR && "We should not spill SGPRs");
  unsigned LiveRegs = IsVGPR ? RPTracker.getPressure().getVGPRNum(false)
                             : RPTracker.getPressure().getSGPRNum();
  unsigned MaxNumOfRegs = IsVGPR ? MaxVGPRs : MaxSGPRs;
  assert(LiveRegs > MaxNumOfRegs && "Expected high reg pressure");

  DenseSet<std::pair<Register, uint64_t>> RegCandidates;
  unsigned NumOfSpills = LiveRegs - MaxNumOfRegs;
  MachineBasicBlock *CurMBB = CurMI->getParent();
  bool IsCurMIInLoop = MLI->getLoopFor(CurMI->getParent());

  // Collect the registers with the longest next-use distance and return them.
  auto GetRegistersWithLongestDistance = [](auto &RegCandidates,
                                            unsigned NumOfSpills) {
    // Collect the registers with the longest next-use distance in
    // 'RegistersToSpill' and return them.
    SmallVector<Register> RegistersToSpill;
    for ([[maybe_unused]] auto I : seq<int>(0, NumOfSpills)) {
      if (RegCandidates.empty())
        break;
      auto It1 = std::max_element(RegCandidates.begin(), RegCandidates.end(),
                                  [](std::pair<Register, uint64_t> Pair1,
                                     std::pair<Register, uint64_t> Pair2) {
                                    return Pair1.second < Pair2.second;
                                  });
      Register DefRegToSpill = It1->first;
      auto It2 =
          llvm::find(RegCandidates, std::make_pair(DefRegToSpill, It1->second));
      if (It2 != RegCandidates.end())
        RegCandidates.erase(It2);
      RegistersToSpill.push_back(DefRegToSpill);
    }

    return RegistersToSpill;
  };
  // If CurMI is not in a loop we collect the registers that we can spill based
  // on their next-use-distance from CurMI in 'RegCandidates'.
  if (!IsCurMIInLoop) {
    LLVM_DEBUG(dbgs() << "===========================================\n");
    // Collect the live registers and their next-use distances in RegCandidates.
    for (auto [CandidateReg, Mask] : RPTracker.getLiveRegs()) {
      bool IsRightClass = IsVGPR ? TRI->isVGPR(*MRI, CandidateReg)
                                 : TRI->isSGPRReg(*MRI, CandidateReg);
      if (isLegalToSpill(CandidateReg) && IsRightClass) {
        SmallVector<MachineInstr *> Uses;
        for (auto &UseMI : MRI->use_nodbg_instructions(CandidateReg)) {
          MachineBasicBlock *UseMBB = UseMI.getParent();
          if (isReachable(CurMBB, UseMBB) ||
              (CurMBB == UseMBB && DT->dominates(CurMI, &UseMI)))
            Uses.push_back(&UseMI);
        }

        if (Uses.empty())
          continue;

        auto NextUseDist = NUA.getNextUseDistance(CandidateReg, CurMI, Uses);
        RegCandidates.insert(std::make_pair(CandidateReg, *NextUseDist));
        LLVM_DEBUG(dbgs() << "Candidate register to spill = "
                          << printReg(CandidateReg, TRI)
                          << " with distance = " << *NextUseDist << "\n");
      }
    }
    LLVM_DEBUG(dbgs() << "==========================================\n");

    // Maybe we cannot spill the live registers.
    if (RegCandidates.empty())
      return {};
    // Return the registers with the longest next-use distance.
    return GetRegistersWithLongestDistance(RegCandidates, NumOfSpills);
  }

  LLVM_DEBUG(dbgs() << "===========================================\n");

  // Collec the live-through values for the case that CurMI is in a loop.
  MachineLoop *OutermostLoop =
      MLI->getLoopFor(CurMI->getParent())->getOutermostLoop();

  auto [DistanceFromHeaderToExitingLatch, ExitingLatch] =
      NUA.getLoopDistanceAndExitingLatch(OutermostLoop->getHeader());
  uint64_t LoopDistance =
      (DistanceFromHeaderToExitingLatch + ExitingLatch->size()) * 1000;

  for (auto [CandidateReg, Mask] : RPTracker.getLiveRegs()) {
    bool IsRightClass = IsVGPR ? TRI->isVGPR(*MRI, CandidateReg)
                               : TRI->isSGPRReg(*MRI, CandidateReg);
    MachineInstr *CandidateMI = &*MRI->def_instr_begin(CandidateReg);
    MachineBasicBlock *CandidateMBB = CandidateMI->getParent();
    MachineLoop *CandidateLoop = MLI->getLoopFor(CandidateMBB);

    if (!CandidateLoop || (CandidateLoop && OutermostLoop &&
                           ((CandidateLoop != OutermostLoop) ||
                            (!CandidateLoop->contains(OutermostLoop) &&
                             !OutermostLoop->contains(CandidateLoop))))) {
      if (isLegalToSpill(CandidateReg) && IsRightClass) {
        SmallVector<MachineInstr *> Uses;
        for (auto &UseMI : MRI->use_nodbg_instructions(CandidateReg)) {
          MachineBasicBlock *UseMBB = UseMI.getParent();
          if (isReachable(CurMBB, UseMBB) ||
              (CurMBB == UseMBB && DT->dominates(CurMI, &UseMI)))
            Uses.push_back(&UseMI);
        }

        if (Uses.empty())
          continue;

        auto NextUseDist = NUA.getNextUseDistance(CandidateReg, CurMI, Uses);
        // Considers only live-through values in the loop.
        if (NextUseDist > LoopDistance) {
          RegCandidates.insert(std::make_pair(CandidateReg, *NextUseDist));
          LLVM_DEBUG(dbgs() << "Candidate register to spill = "
                            << printReg(CandidateReg, TRI)
                            << " with distance = " << *NextUseDist << "\n");
        }
      }
    }
  }
  LLVM_DEBUG(dbgs() << "==========================================\n");
  if (RegCandidates.empty())
    return {};

  // Return the registers with the longest next-use distance.
  return GetRegistersWithLongestDistance(RegCandidates, NumOfSpills);
}

MachineInstr *AMDGPUEarlyRegisterSpilling::emitPHINode(
    MachineBasicBlock *PHIBlock, Register DefRegToSpill,
    MachineBasicBlock *SpillBlock, SmallVector<DomGroup, 2> &Groups,
    SmallVector<MachineInstr *> &DominatedUses,
    DenseMap<MachineBasicBlock *, MachineInstr *> &DefBlocksInstrs,
    const TargetRegisterClass *RC) {

  MachineInstr *FirstNonPHI = &*PHIBlock->getFirstNonPHI();
  const DebugLoc &DL = FirstNonPHI->getDebugLoc();
  Register NewDestReg = MRI->createVirtualRegister(RC);
  MachineInstrBuilder NewPHI =
      BuildMI(*PHIBlock, FirstNonPHI, DL, TII->get(AMDGPU::PHI), NewDestReg);

  for (auto *Pred : PHIBlock->predecessors()) {

    auto getIncomingReg = [&Groups, &DefBlocksInstrs, &DominatedUses,
                           SpillBlock,
                           this](MachineBasicBlock *PredMBB) -> Register {
      if (DominatedUses.size() > 0) {
        for (auto &G1 : Groups) {
          if (G1.isDeleted())
            continue;
          MachineInstr *Head = G1.getHead();
          MachineBasicBlock *UseMBB = Head->getParent();
          if (UseMBB == PredMBB || DT->dominates(UseMBB, PredMBB)) {
            auto It2 = DefBlocksInstrs.find(UseMBB);
            assert(It2 != DefBlocksInstrs.end() &&
                   "The value is not in DefBlocksInstrs map");
            return It2->second->getOperand(0).getReg();
          }
        }
        return Register();
      }

      if (SpillBlock == PredMBB || isReachable(SpillBlock, PredMBB)) {
        auto It3 = DefBlocksInstrs.find(SpillBlock);
        assert(It3 != DefBlocksInstrs.end() &&
               "The value is not in DefBlocksInstrs map");
        return It3->second->getOperand(0).getReg();
      }

      return Register();
    };

    Register IncomingReg = getIncomingReg(Pred);
    NewPHI.addReg(IncomingReg ? IncomingReg : DefRegToSpill);
    NewPHI.addMBB(Pred);
  }
  return NewPHI.getInstr();
}

MachineInstr *AMDGPUEarlyRegisterSpilling::updatePHINode(
    MachineBasicBlock *PHIBlock, MachineInstr *PhiToUpdate,
    const std::map<MachineBasicBlock *, MachineInstr *> &IDFBlockToPhi) {

  for (auto *PredMBB : PHIBlock->predecessors()) {
    auto It1 = IDFBlockToPhi.find(PredMBB);
    if (It1 != IDFBlockToPhi.end()) {
      auto Ops = PhiToUpdate->operands();
      for (auto It2 = std::next(Ops.begin()), It2E = Ops.end(); It2 != It2E;
           It2 = std::next(It2, 2)) {
        auto &RegMO = *It2;
        auto &MBBMO = *std::next(It2);
        assert(RegMO.isReg() && "Expected register operand of PHI");
        assert(MBBMO.isMBB() && "Expected MBB operand of PHI");
        if (MBBMO.getMBB() == PredMBB)
          RegMO.setReg(It1->second->getOperand(0).getReg());
      }
    }
  }

  return PhiToUpdate;
}

void AMDGPUEarlyRegisterSpilling::emitRestoreInstrsForDominatedUses(
    Register DefRegToSpill, MachineInstr *SpillInstruction,
    const SmallVector<MachineInstr *> &DominatedUses,
    SmallVector<DomGroup, 2> &Groups,
    DenseMap<MachineInstr *, MachineInstr *> &UseToRestoreMap,
    SmallVector<MachineInstr *, 2> &ReUses, int FI) {
  MachineLoop *SpillLoop = MLI->getLoopFor(SpillInstruction->getParent());
  DenseMap<MachineInstr *, MachineBasicBlock *> UseToBasicBlock;
  for (auto *Use : DominatedUses) {
    Groups.emplace_back(Use);
    MachineLoop *UseLoop = MLI->getLoopFor(Use->getParent());
    // If a use is in a loop then the restore instruction is emitted in the
    // outermost loop's preheader. Otherwise we emit it just before the use.
    if ((!SpillLoop && UseLoop) ||
        (SpillLoop && UseLoop &&
         !SpillLoop->getOutermostLoop()->contains(UseLoop) &&
         !UseLoop->getOutermostLoop()->contains(SpillLoop))) {
      MachineLoop *OutermostLoop = UseLoop->getOutermostLoop();
      MachineBasicBlock *OutermostLoopPreheader =
          OutermostLoop->getLoopPreheader();
      UseToBasicBlock[Use] = OutermostLoopPreheader;
    } else {
      UseToBasicBlock[Use] = Use->getParent();
    }
  }

  // Create groups of instructions where the group head dominates the rest in
  // the group.
  for (unsigned Idx1 = 0, E = Groups.size(); Idx1 != E; ++Idx1) {
    auto &G1 = Groups[Idx1];
    if (G1.isDeleted())
      continue;
    for (unsigned Idx2 = Idx1 + 1; Idx2 < E; ++Idx2) {
      auto &G2 = Groups[Idx2];
      if (G2.isDeleted())
        continue;
      if (DT->dominates(G1.getHead(), G2.getHead())) {
        G1.merge(G2);
      }
    }
  }

  // For each group emit one restore for the group header. The rest of the uses
  // in the group will reuse the value loaded by the restore of the header.
  for (auto &G1 : Groups) {
    if (G1.isDeleted())
      continue;
    MachineInstr *Head = G1.getHead();
    // TODO: Replace UseToBasicBlock with inline code.
    MachineBasicBlock *HeadMBB = UseToBasicBlock[Head];
    MachineLoop *HeadLoop = MLI->getLoopFor(HeadMBB);
    MachineInstr *Restore = nullptr;
    // If the group head is a PHI we emit the restore in the incoming block.
    if (Head->getOpcode() == AMDGPU::PHI) {
      assert(G1.size() == 1 &&
             "This group cannot have more than 1 instructions!");
      assert(!HeadLoop && "This case is not supported yet.");
      auto Ops = Head->operands();
      for (auto It = std::next(Ops.begin()), ItE = Ops.end(); It != ItE;
           It = std::next(It, 2)) {
        auto &RegMO = *It;
        auto &MBBMO = *std::next(It);
        assert(RegMO.isReg() && "Expected register operand of PHI");
        assert(MBBMO.isMBB() && "Expected MBB operand of PHI");
        if (RegMO.getReg() == DefRegToSpill) {
          Restore = emitRestore(DefRegToSpill, Head, MBBMO.getMBB(), FI);
          UseToRestoreMap[Head] = Restore;
        }
      }
    }
    // In the general case we emit the restore just before the use unless the
    // use is in a loop, in which case we emit the restore at the preheader.
    else {
      // Emit restore instruction before the first use.
      Restore = emitRestore(DefRegToSpill, Head, HeadMBB, FI);
      UseToRestoreMap[Head] = Restore;
    }

    // Update the rest of the uses in the group to reuse the value restored by
    // the head of the group.
    for (auto *U : G1.getUses()) {
      assert(U != SpillInstruction);
      if (U == G1.getHead())
        continue;
      U->substituteRegister(DefRegToSpill, Restore->getOperand(0).getReg(), 0,
                            *TRI);
      ReUses.push_back(U);
    }
  }
}

void AMDGPUEarlyRegisterSpilling::emitRestores(Register DefRegToSpill,
                                               MachineInstr *CurMI,
                                               MachineInstr *SpillInstruction,
                                               const TargetRegisterClass *RC,
                                               int FI) {

  MachineInstr *InstrOfDefRegToSpill = &*MRI->def_instr_begin(DefRegToSpill);
  MachineBasicBlock *DefRegMBB = InstrOfDefRegToSpill->getParent();
  MachineBasicBlock *SpillBlock = SpillInstruction->getParent();

  // Classify uses based on the control flow structure:
  // - DominatedUses are the ones that are dominated by SpillInstruction
  // - ReachableUses are the ones that are reachable by SpillInstruction and we
  //   need to emit a PHI node for them.
  SmallVector<MachineInstr *> DominatedUses;
  SmallVector<MachineInstr *> ReachableUses;
  for (MachineInstr &U : MRI->use_nodbg_instructions(DefRegToSpill)) {
    if (&U == SpillInstruction)
      continue;

    MachineBasicBlock *UBB = U.getParent();
    if (DT->dominates(SpillInstruction, &U)) {
      DominatedUses.push_back(&U);
      continue;
    }
    if (isReachable(SpillBlock, UBB) && !DT->dominates(SpillInstruction, &U)) {
      ReachableUses.push_back(&U);
      continue;
    }
  }

  // If one use dominates other uses, then we emit a single restore instruction
  // for the whole group.
  SmallVector<DomGroup, 2> Groups;
  DenseMap<MachineInstr *, MachineInstr *> UseToRestoreMap;
  SmallVector<MachineInstr *, 2> ReUses;
  emitRestoreInstrsForDominatedUses(DefRegToSpill, SpillInstruction,
                                    DominatedUses, Groups, UseToRestoreMap,
                                    ReUses, FI);

  // For the uses that are reachable by the spill instruction but are not
  // dominated by it, we need to emit PHI nodes to maintain the SSA form.
  // These uses are in 'ReachableUses'.
  // To find the blocks that need PHI nodes we use the Iterated Dominance
  // Frontier algorithm (IDF) which takes as inputs the definitions for these
  // uses. The definitions are: (i) the spill register definition, (ii) the
  // restore instructions that we have emitted so far.
  std::map<MachineBasicBlock *, MachineInstr *> IDFBlockToPhi;
  // Restores that will be generated for reachable uses that are affected by
  // the spill and they are not related to any restore yet.
  SmallVector<MachineInstr *> RestoresForReachableUses;
  if (!ReachableUses.empty()) {
    // DefBlocks contain the definitions of the reachable uses, needed for IDF.
    SmallPtrSet<MachineBasicBlock *, 2> DefBlocks;
    // We start with the block where the spill register is defined.
    DefBlocks.insert(DefRegMBB);
    DenseMap<MachineBasicBlock *, MachineInstr *> DefBlocksInstrs;
    // Find the blocks where we have emitted restore instructions and add them
    // to DefBlocks.
    for (auto *RU : ReachableUses) {
      for (auto &G1 : Groups) {
        if (G1.isDeleted())
          continue;
        MachineInstr *Head = G1.getHead();
        MachineBasicBlock *UseMBB = Head->getParent();
        MachineBasicBlock *ReachableMBB = RU->getParent();
        if (isReachable(UseMBB, ReachableMBB)) {
          DefBlocks.insert(UseMBB);
          auto It1 = UseToRestoreMap.find(Head);
          assert(It1 != UseToRestoreMap.end() &&
                 "The value is not in UseToRestoreMap");
          DefBlocksInstrs[UseMBB] = It1->second;
        }
      }
    }

    // If there are no uses that are dominated by the spill, then we need a
    // restore in the same block as the spill.
    if (DominatedUses.empty()) {
      MachineInstr *Restore = emitRestore(DefRegToSpill, SpillBlock, FI);
      RestoresForReachableUses.push_back(Restore);
      DefBlocks.insert(SpillBlock);
      DefBlocksInstrs[SpillBlock] = Restore;
    }

    // Get the blocks that need PHI nodes in 'IDFBlocks'.
    IDFCalculatorBase<MachineBasicBlock, false> IDF(*DT);
    SmallVector<MachineBasicBlock *> IDFBlocks;
    IDF.setDefiningBlocks(DefBlocks);
    IDF.calculate(IDFBlocks);

    // Create PHI nodes for the blocks in 'IDFBlocks'.
    SmallSet<MachineBasicBlock *, 2> ProcessedBlocks;
    SmallDenseMap<MachineInstr *, Register> ReachableBBRegToReplace;
    for (auto *RU : ReachableUses)
      ReachableBBRegToReplace[RU] = DefRegToSpill;

    while (!IDFBlocks.empty()) {
      MachineBasicBlock *IDFMBB = IDFBlocks.back();
      IDFBlocks.pop_back();

      MachineInstr *PHINode = nullptr;
      auto It1 = IDFBlockToPhi.find(IDFMBB);
      if (It1 == IDFBlockToPhi.end()) {
        PHINode = emitPHINode(IDFMBB, DefRegToSpill, SpillBlock, Groups,
                              DominatedUses, DefBlocksInstrs, RC);
        IDFBlockToPhi[IDFMBB] = PHINode;
        SSAPhiRegs.insert(PHINode->getOperand(0).getReg());
        for (auto *RU : ReachableUses) {
          if (DT->dominates(IDFMBB, RU->getParent())) {
            Register RegToReplace = ReachableBBRegToReplace[RU];
            Register NewValue = PHINode->getOperand(0).getReg();
            if (RU->isPHI()) {
              auto Ops = RU->operands();
              for (auto It2 = std::next(Ops.begin()), It2E = Ops.end();
                   It2 != It2E; It2 = std::next(It2, 2)) {
                auto &RegMO = *It2;
                auto &MBBMO = *std::next(It2);
                assert(RegMO.isReg() && "Expected register operand of PHI");
                assert(MBBMO.isMBB() && "Expected MBB operand of PHI");
                if (MBBMO.getMBB() == IDFMBB)
                  RegMO.setReg(NewValue);
              }
            } else {
              RU->substituteRegister(RegToReplace, NewValue, 0, *TRI);
            }
            ReachableBBRegToReplace[RU] = NewValue;
          }
        }
      } else {
        PHINode = updatePHINode(It1->first, It1->second, IDFBlockToPhi);
        IDFBlockToPhi[IDFMBB] = PHINode;
      }

      for (MachineBasicBlock *MBB :
           llvm::make_early_inc_range(ProcessedBlocks)) {
        if (isReachable(IDFMBB, MBB)) {
          ProcessedBlocks.erase(MBB);
          IDFBlocks.push_back(MBB);
        }
      }
      ProcessedBlocks.insert(IDFMBB);
    }
  }

  // Update the live interval analysis.
  LIS->InsertMachineInstrInMaps(*SpillInstruction);
  updateIndexes(InstrOfDefRegToSpill);
  updateIndexes(SpillInstruction);
  updateLiveness(InstrOfDefRegToSpill);
  updateLiveness(SpillInstruction);

  if (InstrOfDefRegToSpill != CurMI)
    updateIndexes(CurMI);
  updateLiveness(CurMI);

  for (auto [Use, Restore] : UseToRestoreMap) {
    updateIndexes(Restore);
    updateIndexes(Use);
    updateLiveness(Restore);
    updateLiveness(Use);
  }

  for (auto *R : RestoresForReachableUses) {
    updateIndexes(R);
    updateLiveness(R);
  }

  for (auto *Use : ReUses) {
    updateIndexes(Use);
    updateLiveness(Use);
  }

  for (auto &P : IDFBlockToPhi) {
    updateIndexes(P.second);
    updateLiveness(P.second);
  }

  for (auto *U : ReachableUses) {
    updateIndexes(U);
    updateLiveness(U);
  }
}

void AMDGPUEarlyRegisterSpilling::spill(MachineInstr *CurMI,
                                        GCNDownwardRPTracker &RPTracker,
                                        bool IsVGPR) {
  for (Register DefRegToSpill : getRegistersToSpill(CurMI, RPTracker, IsVGPR)) {
    MachineInstr *InstrOfDefRegToSpill = &*MRI->def_instr_begin(DefRegToSpill);
    MachineBasicBlock *DefRegMBB = InstrOfDefRegToSpill->getParent();
    MachineBasicBlock *CurMBB = CurMI->getParent();
    assert((!DT->dominates(CurMI, InstrOfDefRegToSpill) ||
            !isReachable(CurMBB, DefRegMBB)) &&
           "This register should not be spilled");
    const TargetRegisterClass *RC = TRI->getRegClassForReg(*MRI, DefRegToSpill);
    unsigned Size = TRI->getSpillSize(*RC);
    Align Alignment = TRI->getSpillAlign(*RC);
    int FI = FrameInfo->CreateSpillStackObject(Size, Alignment);
    MachineLoop *DefInstrLoop =
        MLI->getLoopFor(InstrOfDefRegToSpill->getParent());
    MachineLoop *CurLoop = MLI->getLoopFor(CurMI->getParent());
    if (CurLoop)
      CurLoop = CurLoop->getOutermostLoop();

    MachineInstr *SpillInstruction = nullptr;
    // - the register we are about to spill (DefRegToSpill) is defined in loop
    // - the high register pressure (CurMI) is outside the loop
    // - we emit the spill instruction in one of the exit blocks of the loop
    if ((DefInstrLoop && !CurLoop) ||
        (DefInstrLoop && CurLoop &&
         ((DefInstrLoop != CurLoop) || (!DefInstrLoop->contains(CurLoop) &&
                                        !CurLoop->contains(DefInstrLoop))))) {
      SmallVector<MachineBasicBlock *> ExitBlocks;
      MachineLoop *OutermostLoop = DefInstrLoop->getOutermostLoop();
      OutermostLoop->getUniqueExitBlocks(ExitBlocks);
      for (auto *ExitBB : ExitBlocks) {
        if (DT->dominates(ExitBB, CurMBB)) {
          if (ExitBB == CurMBB) {
            TII->storeRegToStackSlot(*ExitBB, CurMI->getIterator(),
                                     DefRegToSpill, true, /* kill */
                                     FI, RC, TRI, Register());
            SpillInstruction = CurMI->getPrevNode();
          } else {
            auto It = ExitBB->getFirstTerminator();
            if (It == ExitBB->end())
              It = ExitBB->instr_end();
            TII->storeRegToStackSlot(*ExitBB, It, DefRegToSpill,
                                     true, /* kill */
                                     FI, RC, TRI, Register());
            SpillInstruction = &*std::prev(It);
          }

          break;
        }
      }
    }
    // - the register we are about to spill is outside the loop
    // - the high register pressure instruction (CurMI) is inside the loop
    // - we emit the spill instruction in the loop preheader
    else if (!DefInstrLoop && CurLoop) {
      MachineBasicBlock *CurLoopPreheader = CurLoop->getLoopPreheader();
      auto It = CurLoopPreheader->getFirstTerminator();
      if (It == CurLoopPreheader->end())
        It = CurLoopPreheader->back();
      TII->storeRegToStackSlot(*CurLoopPreheader, It, DefRegToSpill,
                               true, /* kill */
                               FI, RC, TRI, Register());
      SpillInstruction = &*(std::prev(It));
    }
    // - the high register pressure instruction is a PHI node
    // - we emit the spill instruction before the first non-PHI instruction
    else if (CurMI->getOpcode() == AMDGPU::PHI &&
             CurMI == InstrOfDefRegToSpill) {
      auto WhereToSpill = CurMBB->getFirstNonPHI();
      TII->storeRegToStackSlot(*CurMI->getParent(), WhereToSpill, DefRegToSpill,
                               true, /* kill */
                               FI, RC, TRI, Register());
      SpillInstruction = &*CurMI->getParent()->getFirstNonPHI();
      // Move the defining phi node before the spill instruction to reduce
      // the distance between the phi and the spill.
      CurMI->moveBefore(SpillInstruction);
    }
    // - the high register pressure instruction is also the instruction that
    //   defines the register we are about to spill
    // - we emit the spill instruction after the high reg pressure instr
    else if (CurMI == InstrOfDefRegToSpill) {
      auto WhereToSpill = std::next(CurMI->getIterator());
      TII->storeRegToStackSlot(*CurMBB, WhereToSpill, DefRegToSpill,
                               true, /* kill */
                               FI, RC, TRI, Register());
      SpillInstruction = CurMI->getNextNode();
    }
    // - this is the general case. We spill just before the instruction where we
    //   detect high register pressure.
    else {
      auto WhereToSpill = CurMI->getIterator();
      TII->storeRegToStackSlot(*CurMBB, WhereToSpill, DefRegToSpill,
                               true, /* kill */
                               FI, RC, TRI, Register());
      SpillInstruction = CurMI->getPrevNode();
    }

    SpilledRegs.insert(DefRegToSpill);
    NumOfERSSpills++;

    assert(SpillInstruction && "There is not a spill instruction");

    // Find the restore locations, emit the restore instructions and maintain
    // SSA when needed.
    emitRestores(DefRegToSpill, CurMI, SpillInstruction, RC, FI);
  }
  // Reset the tracker because it has already read the next instruction which
  // we might have modified by a emitting a spill or restore instruction.
  RPTracker.reset(*CurMI);
  RPTracker.advance();
}

bool AMDGPUEarlyRegisterSpilling::runOnMachineFunction(MachineFunction &MF) {

  if (skipFunction(MF.getFunction()))
    return false;

  if (!EarlyRegisterSpilling)
    return false;

  const GCNSubtarget &ST = MF.getSubtarget<GCNSubtarget>();
  TII = ST.getInstrInfo();
  TRI = &TII->getRegisterInfo();
  MLI = &getAnalysis<MachineLoopInfoWrapperPass>().getLI();
  MRI = &MF.getRegInfo();
  MFI = MF.getInfo<SIMachineFunctionInfo>();
  FrameInfo = &MF.getFrameInfo();
  LIS = &getAnalysis<LiveIntervalsWrapperPass>().getLIS();
  LV = &getAnalysis<LiveVariablesWrapperPass>().getLV();
  Indexes = &getAnalysis<SlotIndexesWrapperPass>().getSI();
  DT = &getAnalysis<MachineDominatorTreeWrapperPass>().getDomTree();
  PDT = &getAnalysis<MachinePostDominatorTreeWrapperPass>().getPostDomTree();
  DF = &getAnalysis<MachineDominanceFrontier>();
  NUA.run(MF, MLI);

  // Compute max register pressure across all blocks using GCNRPTracker
  GCNDownwardRPTracker RPTrackerTemp(*LIS);
  GCNRegPressure MaxPressure;
  for (MachineBasicBlock &MBB : MF) {
    if (MBB.empty())
      continue;
    RPTrackerTemp.reset(*MBB.begin());
    for (MachineInstr &MI : MBB) {
      if (MI.isDebugInstr())
        continue;
      RPTrackerTemp.advance();
      MaxPressure = max(MaxPressure, RPTrackerTemp.getPressure());
    }
  }

  unsigned VgprNum = MaxPressure.getVGPRNum(ST.hasGFX90AInsts());
  unsigned Occupancy =
      ST.getOccupancyWithNumVGPRs(VgprNum, ST.getDynamicVGPRBlockSize());
  MaxSGPRs = SGPRMaxNums > 0 ? SGPRMaxNums
                             : std::min(ST.getMaxNumSGPRs(Occupancy, true),
                                        ST.getMaxNumSGPRs(MF));
  MaxVGPRs =
      VGPRMaxNums > 0
          ? VGPRMaxNums
          : std::min(ST.getMaxNumVGPRs(Occupancy, ST.getDynamicVGPRBlockSize()),
                     ST.getMaxNumVGPRs(MF));

  LLVM_DEBUG(dbgs() << "===========================================\n");
  LLVM_DEBUG(dbgs() << "Early Register Spilling\n");
  LLVM_DEBUG(dbgs() << "===========================================\n");
  LLVM_DEBUG(dbgs() << MF.getName() << "\n");
  LLVM_DEBUG(dbgs() << "MaxSGPRs = " << MaxSGPRs << "\n");
  LLVM_DEBUG(dbgs() << "MaxVGPRs = " << MaxVGPRs << "\n");

  // Calculate the number of excessive SGPRs using GCNRPTracker.
  unsigned NumOfVGPRsForSGPR = 0;
  unsigned ExcessiveSGPRs = 0;
  GCNDownwardRPTracker RPTrackerForSGPR(*LIS);
  for (MachineBasicBlock &MBB : MF) {
    if (MBB.empty())
      continue;
    RPTrackerForSGPR.reset(*MBB.begin());
    for (MachineInstr &MI : MBB) {
      if (MI.isDebugInstr())
        continue;
      RPTrackerForSGPR.advance();
      unsigned SGPRNumPerMBB = RPTrackerForSGPR.getPressure().getSGPRNum();
      if (SGPRNumPerMBB > MaxSGPRs)
        ExcessiveSGPRs += SGPRNumPerMBB - MaxSGPRs;
    }
  }
  // Calculate how many VGPRs are needed for SGPR spilling.
  if (ExcessiveSGPRs > 0) {
    // Check whether we should group 32 or 64 SGPRs.
    auto NumOfSGPRsToGroup =
        MF.getSubtarget<GCNSubtarget>().isWave32() ? 32 : 64;
    NumOfVGPRsForSGPR = std::ceil((float)ExcessiveSGPRs / NumOfSGPRsToGroup);
  }

  GCNDownwardRPTracker RPTracker(*LIS);
  ReversePostOrderTraversal<MachineFunction *> RPOT(&MF);

  for (MachineBasicBlock *MBB : RPOT) {
    LLVM_DEBUG(dbgs() << "===========================================\n");
    LLVM_DEBUG(dbgs() << "Current basic block = " << MBB->getName() << "\n");
    LLVM_DEBUG(dbgs() << "===========================================\n");
    if (MBB->empty())
      continue;

    // Initialize the Register Pressure Tracker at the beginning of the
    // block.
    RPTracker.reset(*MBB->begin());
    RPTracker.advance();

    // Iterate over the instructions of MBB and check if the live registers
    // are more than the available registers.
    for (auto It = MBB->begin(), ItE = MBB->end(); It != ItE; ++It) {
      MachineInstr *MI = &*It;

      if (MI->isDebugInstr())
        continue;

      if (!isSpillSaveInstr(MI) && !isSpillRestoreInstr(MI) &&
          !isBranchInstr(MI)) {
        const MachineInstr *LastTrackedMI = RPTracker.getLastTrackedMI();
        assert(MI == LastTrackedMI && "The tracker and the loop iteration "
                                      "should visit the same instruction.");
        unsigned SGPRLiveRegs = RPTracker.getPressure().getSGPRNum();
        unsigned VGPRLiveRegs = RPTracker.getPressure().getVGPRNum(false);

        LLVM_DEBUG(dbgs() << "==========================================\n");
        LLVM_DEBUG(dbgs() << "Current Instruction = " << *MI << "\n");
        LLVM_DEBUG(dbgs() << "SGPRLiveRegs = " << SGPRLiveRegs << "\n");
        LLVM_DEBUG(dbgs() << "VGPRLiveRegs = " << VGPRLiveRegs << "\n");
        LLVM_DEBUG(dbgs() << "==========================================\n");

        // Spill if the live SGPR registers are more than the available
        // SGPRs.
        if (EarlyRegisterSpillingSGPRs && SGPRLiveRegs > MaxSGPRs)
          spill(MI, RPTracker, false);

        // Spill if the live VGPR registers are more than the available
        // VGPRs.
        if (VGPRLiveRegs > (MaxVGPRs - NumOfVGPRsForSGPR))
          spill(MI, RPTracker, true);
      }

      // Move the tracker to the next instruction.
      // If we have reached the bottom of a basic block, then we have to
      // initialize the tracker at the beginning of the next basic block.
      if (MI == &MBB->back())
        continue;

      // Phi nodes might include registers that are defined later in the
      // code. Hence, we have to initialize the tracker again.
      if (MI->getOpcode() == AMDGPU::PHI)
        RPTracker.reset(*MI->getNextNode());
      RPTracker.advance();
    }
  }

  clearTables();
  return true;
}

char AMDGPUEarlyRegisterSpilling::ID = 0;

INITIALIZE_PASS_BEGIN(AMDGPUEarlyRegisterSpilling, DEBUG_TYPE,
                      "Early Register Spilling", false, false)
INITIALIZE_PASS_DEPENDENCY(MachineLoopInfoWrapperPass)
INITIALIZE_PASS_DEPENDENCY(SlotIndexesWrapperPass)
INITIALIZE_PASS_DEPENDENCY(LiveIntervalsWrapperPass)
INITIALIZE_PASS_DEPENDENCY(LiveVariablesWrapperPass)
INITIALIZE_PASS_DEPENDENCY(MachineDominatorTreeWrapperPass)
INITIALIZE_PASS_DEPENDENCY(MachinePostDominatorTreeWrapperPass)
INITIALIZE_PASS_DEPENDENCY(MachineDominanceFrontier)
INITIALIZE_PASS_END(AMDGPUEarlyRegisterSpilling, DEBUG_TYPE,
                    "Early Register Spilling", false, false)

char &llvm::AMDGPUEarlyRegisterSpillingID = AMDGPUEarlyRegisterSpilling::ID;

FunctionPass *llvm::createAMDGPUEarlyRegisterSpillingPass() {
  return new AMDGPUEarlyRegisterSpilling();
}

